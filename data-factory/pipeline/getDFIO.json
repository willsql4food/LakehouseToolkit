{
	"name": "getDFIO",
	"properties": {
		"description": "Collects DFIO files from SFTP site and places unzipped files on Datalake storage.\nDFIO = Demand Forecast Inventory Optimization",
		"activities": [
			{
				"name": "Get Pipeline Parameters",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select sourceDsSftpHostName = 'fdcr-dev-b2b.logistics.com' \n    , sourceDsSftpPortNumber = 22\n    , sourceDsSshHostKey = 'ssh-ed25519 32 75:45:0c:a2:a7:42:c1:10:8c:2d:cb:aa:0f:90:fb:75'\n    , sourceDsUserName = 'sftpadmin' \n    , sourceDsPassphraseSecret = 'dfio-sftp-passphrase' \n    , sourceDsPrivateKeySecret = 'dfio-sftp-private-key' \n    , sourceDsDirectory = '/outbox/extracts/'\n    , sourceDsFilePattern = '*.tar.gz'\n    , sourceDsCompressionType = 'TarGZip'\n    , sourceDsDatabricksWorkspaceId = '/subscriptions/4c87027a-d0a7-4f47-b9c4-31447460fbef/resourceGroups/rg-sbx-ab092898/providers/Microsoft.Databricks/workspaces/dbx-sbx-ab092898'\n    , sourceDsDatabricksNotebookPath = '/Repos/ENTDATALAKEHOUSE/databricks-entdatalakehouse/BRONZE-SILVER/PLCC_Decryption'\n    , sourceDsDatabricksWorkspaceUrl = 'https://adb-7286372339506263.3.azuredatabricks.net'\n    , sourceDsDbxClusterNodeType = 'Standard_D4ds_v5'\n    , sourceDsDbxClusterVersion = '15.4.x-scala2.12'\n    , sourceDsDbxWorkerOptions = '1:8'\n    , sourceDsDbxUnityCatalogEnabled = 'false'\n    , sinkDsURL = 'https://staab09289802.dfs.core.windows.net'\n    , sinkDsSecretName = 'key-staab09289802'\n    , sinkDsStorageAccount = 'staab09289802'\n    , sinkDsFileSystem = 'landing'\n    , sinkDsDirectory = 'DFIO'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "WatermarkMI",
						"type": "DatasetReference",
						"parameters": {
							"dsServerName": {
								"value": "@pipeline().globalParameters.gpWMSQL",
								"type": "Expression"
							},
							"dsDatabaseName": {
								"value": "@pipeline().globalParameters.gpWMDatabase",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Copy Files",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Get Pipeline Parameters",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "SftpReadSettings",
							"recursive": false,
							"wildcardFileName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsFilePattern",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "BinSftpSshKeyCompressed",
						"type": "DatasetReference",
						"parameters": {
							"dsHostName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpHostName",
								"type": "Expression"
							},
							"dsPortNumber": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpPortNumber",
								"type": "Expression"
							},
							"dsUserName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsUserName",
								"type": "Expression"
							},
							"dsKvUrl": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							},
							"dsPrivateKeySecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPrivateKeySecret",
								"type": "Expression"
							},
							"dsPassphraseSecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPassphraseSecret",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDirectory",
								"type": "Expression"
							},
							"dsSshHostKey": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSshHostKey",
								"type": "Expression"
							},
							"dsCompressionType": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsCompressionType",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "BinDL",
						"type": "DatasetReference",
						"parameters": {
							"dsURL": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsURL",
								"type": "Expression"
							},
							"dsSecretName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsSecretName",
								"type": "Expression"
							},
							"dsFileSystem": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsFileSystem",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsDirectory",
								"type": "Expression"
							},
							"dsKVBaseURL": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Decrypt Files",
				"type": "DatabricksNotebook",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Copy Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksNotebookPath",
						"type": "Expression"
					},
					"baseParameters": {
						"environment": {
							"value": "@pipeline().globalParameters.gpEnvironment",
							"type": "Expression"
						},
						"sourceName": "PLCC"
					}
				},
				"linkedServiceName": {
					"referenceName": "GenericAzureDatabricksNewJobClusterMI",
					"type": "LinkedServiceReference",
					"parameters": {
						"lsDatabricksWorkspaceURL": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksWorkspaceUrl",
							"type": "Expression"
						},
						"lsWorkspaceResourceId": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksWorkspaceId",
							"type": "Expression"
						},
						"lsClusterVersion": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDbxClusterVersion",
							"type": "Expression"
						},
						"lsClusterNodeType": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDbxClusterNodeType",
							"type": "Expression"
						},
						"lsWorkerOptions": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDbxWorkerOptions",
							"type": "Expression"
						},
						"lsUnityCatalogEnabled": {
							"value": "@not(equals(pipeline().globalParameters.gpEnvironment, 'SBX'))",
							"type": "Expression"
						}
					}
				}
			}
		],
		"annotations": []
	}
}