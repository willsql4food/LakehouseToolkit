{
	"name": "poc-SQL-Multi-Connect",
	"properties": {
		"activities": [
			{
				"name": "TryConnAzure",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzSqlDb",
						"type": "DatasetReference",
						"parameters": {
							"sqlFqdn": {
								"value": "@pipeline().parameters.ServerFqdnPref",
								"type": "Expression"
							},
							"dbName": "LoadControl"
						}
					}
				}
			},
			{
				"name": "TryConnOnPremises",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select name from sys.tables",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "OpSqlDb",
						"type": "DatasetReference",
						"parameters": {
							"sqlFqdn": {
								"value": "@pipeline().parameters.ServerFqdnAlt",
								"type": "Expression"
							},
							"dbName": "LoadControl",
							"userName": "AB092898@flooranddecor.com"
						}
					}
				}
			}
		],
		"parameters": {
			"ServerFqdnAzure": {
				"type": "string",
				"defaultValue": "sql-ab092898.database.windows.net"
			},
			"ServerFqdnOnPrem": {
				"type": "string",
				"defaultValue": "OnPremises"
			}
		},
		"annotations": []
	}
}