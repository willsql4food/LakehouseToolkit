					}
				}
			}
		],
		"parameters": {
			"WhereAmI": {
				"type": "string",
				"defaultValue": "NOWHERE"
			}
		},
		"variables": {
			"WhereIAm": {
				"type": "String",
				"defaultValue": "DONTKNOW"
			}
		},
		"annotations": []
	}
}