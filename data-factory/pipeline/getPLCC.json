{
	"name": "getPLCC",
	"properties": {
		"activities": [
			{
				"name": "Get Pipeline Parameters",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select sourceSftpHostName = 'astra-stg-sftp.syfbk.com' \n    , sourceSftpPortNumber = 2022 \n    , sourceUserName = 'NPA-svc-astra-e01448' \n    , sourcePasswordSecret = 'plcc-sftp-password' \n    , sourcePrivateKeySecret = 'plcc-sftp-private-key' \n    , sourceDirectory = '\\outbound\\'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "WatermarkMI",
						"type": "DatasetReference",
						"parameters": {
							"dsServerName": {
								"value": "@pipeline().globalParameters.gpWMSQL",
								"type": "Expression"
							},
							"dsDatabaseName": {
								"value": "@pipeline().globalParameters.gpWMDatabase",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Get File List",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Pipeline Parameters",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "BinarySftpPrivateKey",
						"type": "DatasetReference",
						"parameters": {
							"dsHostName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceSftpHostName",
								"type": "Expression"
							},
							"dsPortNumber": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceSftpPortNumber",
								"type": "Expression"
							},
							"dsUserName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceUserName",
								"type": "Expression"
							},
							"dsKvUrl": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							},
							"dsPrivateKeySecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourcePrivateKeySecret",
								"type": "Expression"
							},
							"dsPasswordSecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourcePasswordSecret",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDirectory",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			}
		],
		"annotations": []
	}
}