{
	"name": "getPLCC",
	"properties": {
		"activities": [
			{
				"name": "Get Pipeline Parameters",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select sourceDsSftpHostName = 'astra-stg-sftp.syfbk.com' \n    , sourceDsSftpPortNumber = 2022 \n    , sourceDsUserName = 'NPA-svc-astra-e01448' \n    , sourceDsPasswordSecret = 'plcc-sftp-password' \n    , sourceDsPrivateKeySecret = 'plcc-sftp-private-key' \n    , sourceDsDirectory = '\\outbound\\'\n    , sourceDsDatabricksWorkspaceId = '/subscriptions/4c87027a-d0a7-4f47-b9c4-31447460fbef/resourceGroups/rg-sbx-ab092898/providers/Microsoft.Databricks/workspaces/dbx-sbx-ab092898'\n    , sourceDsDatabricksNotebookPath = '/Repos/ENTDATALAKEHOUSE/databricks-entdatalakehouse/BRONZE-SILVER/PLCC_Decryption'\n    , sourceDsDatabricksWorkspaceUrl = 'https://adb-7286372339506263.3.azuredatabricks.net'\n    , sourceDsDbxClusterNodeType= 'Standard_D4ds_v5'\n    , sourceDsDbxWorkerOptions= '1:8'\n    , sinkDsURL = 'https://staab09289802.dfs.core.windows.net'\n    , sinkDsSecretName = 'key-staab09289802'\n    , sinkDsStorageAccount = 'staab09289802'\n    , sinkDsFileSystem = 'landing'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "WatermarkMI",
						"type": "DatasetReference",
						"parameters": {
							"dsServerName": {
								"value": "@pipeline().globalParameters.gpWMSQL",
								"type": "Expression"
							},
							"dsDatabaseName": {
								"value": "@pipeline().globalParameters.gpWMDatabase",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Get File List",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Pipeline Parameters",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "BinarySftpPrivateKey",
						"type": "DatasetReference",
						"parameters": {
							"dsHostName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpHostName",
								"type": "Expression"
							},
							"dsPortNumber": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpPortNumber",
								"type": "Expression"
							},
							"dsUserName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsUserName",
								"type": "Expression"
							},
							"dsKvUrl": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							},
							"dsPrivateKeySecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPrivateKeySecret",
								"type": "Expression"
							},
							"dsPasswordSecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPasswordSecret",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDirectory",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get File List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get File List').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().type, 'File')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy Files",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "SftpReadSettings",
							"recursive": false,
							"deleteFilesAfterCompletion": false,
							"disableChunking": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "BinarySftpPrivateKey",
						"type": "DatasetReference",
						"parameters": {
							"dsHostName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpHostName",
								"type": "Expression"
							},
							"dsPortNumber": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsSftpPortNumber",
								"type": "Expression"
							},
							"dsUserName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsUserName",
								"type": "Expression"
							},
							"dsKvUrl": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							},
							"dsPrivateKeySecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPrivateKeySecret",
								"type": "Expression"
							},
							"dsPasswordSecret": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsPasswordSecret",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDirectory",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "BinaryDL",
						"type": "DatasetReference",
						"parameters": {
							"dsURL": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsURL",
								"type": "Expression"
							},
							"dsSecretName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsSecretName",
								"type": "Expression"
							},
							"dsFileSystem": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsFileSystem",
								"type": "Expression"
							},
							"dsDirectory": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsDirectory",
								"type": "Expression"
							},
							"dsKVBaseURL": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sinkDsKVBaseURL",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Decrypt Files",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksNotebookPath",
						"type": "Expression"
					}
				},
				"linkedServiceName": {
					"referenceName": "GenericAzureDatabricksNewJobClusterMI",
					"type": "LinkedServiceReference",
					"parameters": {
						"lsDatabricksWorkspaceURL": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksWorkspaceUrl",
							"type": "Expression"
						},
						"lsWorkspaceResourceId": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDatabricksWorkspaceId",
							"type": "Expression"
						},
						"lsClusterVersion": "14.3.x-scala2.12",
						"lsClusterNodeType": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDbxClusterNodeType",
							"type": "Expression"
						},
						"lsWorkerOptions": {
							"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceDsDbxWorkerOptions",
							"type": "Expression"
						}
					}
				}
			}
		],
		"annotations": []
	}
}