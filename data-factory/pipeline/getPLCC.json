{
	"name": "getPLCC",
	"properties": {
		"activities": [
			{
				"name": "Get Pipeline Parameters",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select sourceSftpHost = 'astra-stg-sftp.syfbk.com' \n    , sourceSftpPort = 2022 \n    , sourceUserName = 'NPA-svc-astra-e01448' \n    , sourceSecretNamePassword = 'plcc-sftp-password' \n    , sourceFilePath = '\\'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "WatermarkMI",
						"type": "DatasetReference",
						"parameters": {
							"dsServerName": {
								"value": "@pipeline().globalParameters.gpWMSQL",
								"type": "Expression"
							},
							"dsDatabaseName": {
								"value": "@pipeline().globalParameters.gpWMDatabase",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Get File List",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Pipeline Parameters",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "BinSftp",
						"type": "DatasetReference",
						"parameters": {
							"dsHost": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceSftpHost",
								"type": "Expression"
							},
							"dsSecretName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceSecretNamePassword",
								"type": "Expression"
							},
							"dsUserName": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceUserName",
								"type": "Expression"
							},
							"dsBaseURL": {
								"value": "@pipeline().globalParameters.BronzeIngestionKvUrl",
								"type": "Expression"
							},
							"dsFilePath": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceFilePath",
								"type": "Expression"
							},
							"dsSftpPort": {
								"value": "@activity('Get Pipeline Parameters').output.firstRow.sourceSftpPort",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			}
		],
		"annotations": []
	}
}