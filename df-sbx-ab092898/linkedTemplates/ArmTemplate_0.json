{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-sbx-ab092898"
		},
		"AzSqlDb_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzSqlDb'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=@{linkedService().serverName};Initial Catalog=@{linkedService().dbName}"
		},
		"GenericAzureSqlDatabaseMI_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'GenericAzureSqlDatabaseMI'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=@{linkedService().lsServerName};Initial Catalog=@{linkedService().lsDatabaseName}"
		},
		"AzBlobStore_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://staab09289802.blob.core.windows.net/"
		},
		"AzKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://akv-ab092898.vault.azure.net/"
		},
		"GenericAzureKeyVaultMI_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "@{linkedService().lsBaseURL}"
		},
		"RestApi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().baseUrl}"
		},
		"AzBatch_properties_typeProperties_batchUri": {
			"type": "string",
			"defaultValue": "https://batsbxab092898.eastus2.batch.azure.com"
		},
		"AzBatch_properties_typeProperties_poolName": {
			"type": "string",
			"defaultValue": "batsbxab092898-pool1"
		},
		"AzBatch_properties_typeProperties_accountName": {
			"type": "string",
			"defaultValue": "batsbxab092898"
		},
		"AzDLStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().StorageAccount}"
		},
		"FileServer_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "@{linkedService().lsHost}"
		},
		"FileServer_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "@{linkedService().lsUserName}"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Environment Trigger test')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Set variable1",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [
							{
								"name": "UserProp",
								"value": "@{pipeline().variables(\"WhereAmI\")}"
							}
						],
						"typeProperties": {
							"variableName": "WhereIAm",
							"value": {
								"value": "@if(contains(pipeline().parameters.WhereAmI, pipeline().globalParameters.gpEnvironment), 'Where I belong', 'Not authorized to run on @{pipeline().parameters.WhereAmI}')",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"WhereAmI": {
						"type": "string",
						"defaultValue": "NOSBXHERE"
					}
				},
				"variables": {
					"WhereIAm": {
						"type": "String",
						"defaultValue": "DONTKNOW"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzBlobStore')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"serviceEndpoint": "[parameters('AzBlobStore_properties_typeProperties_serviceEndpoint')]",
					"accountKind": "Storage"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzDatabricksJobCluster')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"lsWorkspaceUrl": {
						"type": "string",
						"defaultValue": "https://adb-7286372339506263.3.azuredatabricks.net"
					},
					"lsWorkspaceResourceId": {
						"type": "string",
						"defaultValue": "/subscriptions/4c87027a-d0a7-4f47-b9c4-31447460fbef/resourceGroups/rg-sbx-ab092898/providers/Microsoft.Databricks/workspaces/dbx-sbx-ab092898"
					}
				},
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "@linkedService().lsWorkspaceUrl",
					"authentication": "MSI",
					"workspaceResourceId": "@linkedService().lsWorkspaceResourceId",
					"newClusterNodeType": "Standard_DS4_v2",
					"newClusterNumOfWorker": "1:4",
					"newClusterSparkEnvVars": {
						"PYSPARK_PYTHON": "/databricks/python3/bin/python3"
					},
					"newClusterVersion": "14.3.x-scala2.12",
					"clusterOption": "Autoscaling",
					"newClusterInitScripts": []
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzDeltalake')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricksDeltaLake",
				"typeProperties": {
					"domain": "https://adb-7286372339506263.3.azuredatabricks.net",
					"clusterId": "0617-202045-ptvwkoat",
					"workspaceResourceId": "/subscriptions/4c87027a-d0a7-4f47-b9c4-31447460fbef/resourceGroups/rg-sbx-ab092898/providers/Microsoft.Databricks/workspaces/dbx-sbx-ab092898"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzKeyVault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('AzKeyVault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzSqlDb')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"serverName": {
						"type": "string",
						"defaultValue": "sql-ab092898.database.windows.net"
					},
					"dbName": {
						"type": "string",
						"defaultValue": "LoadControl"
					}
				},
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"connectionString": "[parameters('AzSqlDb_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/GenericAzureDatabricksNewJobClusterMI')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"lsDatabricksWorkspaceURL": {
						"type": "string"
					},
					"lsWorkspaceResourceId": {
						"type": "string"
					},
					"lsClusterVersion": {
						"type": "string",
						"defaultValue": "14.3.x-scala2.12"
					},
					"lsClusterNodeType": {
						"type": "string"
					},
					"lsWorkerOptions": {
						"type": "string"
					},
					"lsUnityCatalogEnabled": {
						"type": "bool",
						"defaultValue": true
					}
				},
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "@linkedService().lsDatabricksWorkspaceURL",
					"authentication": "MSI",
					"workspaceResourceId": "@linkedService().lsWorkspaceResourceId",
					"newClusterNodeType": "@linkedService().lsClusterNodeType",
					"newClusterNumOfWorker": "@linkedService().lsWorkerOptions",
					"newClusterSparkConf": {
						"spark.databricks.io.cache.enabled": "true",
						"spark.databricks.io.cache.compression.enabled": "false",
						"spark.databricks.io.cache.maxDiskUsage": "50g",
						"spark.databricks.io.cache.maxMetaDataCache": "1g",
						"spark.databricks.delta.schema.autoMerge.enabled": "true",
						"spark.sql.sources.partitionOverwriteMode": "dynamic",
						"spark.databricks.unityCatalog.enabled": {
							"value": "@linkedService().lsUnityCatalogEnabled",
							"type": "Expression"
						},
						"spark.rpc.message.maxSize": "1024"
					},
					"newClusterSparkEnvVars": {
						"PYSPARK_PYTHON": "/databricks/python3/bin/python3"
					},
					"newClusterVersion": "@linkedService().lsClusterVersion",
					"clusterOption": "Autoscaling",
					"newClusterInitScripts": [],
					"dataSecurityMode": "USER_ISOLATION"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/GenericAzureKeyVaultMI')]",
